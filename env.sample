EVM_ADDRESS=<0xPREFIXED_EVM_ADDRESS>
SECRET=<BITCOIN_SECRET_32_BYTE_HEX>
BRC20_RPC_URL=<BRC20_PROG_SERVER>
BITCOIN_RPC_URL=<BITCOIN_RPC_URL>
BITCOIN_RPC_USER=<BITCOIN_RPC_USER>
BITCOIN_RPC_PASSWORD=<BITCOIN_RPC_PASSWORD>
BITCOIN_NETWORK=bitcoin
FEE_RATE_CATEGORY=fastest
PROXY_SERVER_ADDRESS=127.0.0.1:8545
# Optional. Caps gas_limit-driven inscription padding (default 1000000 = 1 MB, BRC2.0 calldata limit).
# Rejects absurd/fat-fingered sizes that would OOM during padding. Override only if needed.
# MAX_INSCRIPTION_BYTES=1000000
# Optional. When set, require Authorization: Bearer <token> on JSON-RPC requests.
# Required when PROXY_SERVER_ADDRESS is not loopback, unless ALLOW_REMOTE_BIND=true.
# RPC_AUTH_TOKEN=
# Optional. Allow non-loopback bind without RPC_AUTH_TOKEN.
# ALLOW_REMOTE_BIND=false
# Optional. Enable CORS (* or a single origin). Unset leaves CORS off.
# CORS_ALLOW_ORIGIN=
